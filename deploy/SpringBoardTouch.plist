<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Injects SpringBoardTouch.dylib into backboardd (the HID server), not into
     SpringBoard: backboardd is the process that owns the digitizer and it
     survives SpringBoard resprings. -->
<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <string>com.apple.backboardd</string>
        </array>
    </dict>
</dict>
</plist>
