<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.arcflow.wgtunnel — WireGuard tunnel auto-start LaunchDaemon
  Deployed to /var/jb/Library/LaunchDaemons/com.arcflow.wgtunnel.plist
  Runs /var/jb/usr/local/bin/wg_up.sh at boot after palera1n remounts /var/jb.

  Distinct from the legacy com.arcflow.tunnel.plist (autossh reverse tunnel,
  pre-WireGuard era, kept for historical reference but broken).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.arcflow.wgtunnel</string>

    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/bin/bash</string>
        <string>/var/jb/usr/local/bin/wg_up.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/var/jb/usr/local/bin:/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- KeepAlive=true: if wireguard-go dies, launchd respawns wg_up.sh.
         Combined with the wait $WGPID in the script, this gives us a
         proper daemon lifecycle: script blocks on wg-go, wg-go dies,
         script exits, launchd restarts after ThrottleInterval=30s. -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/var/mobile/wg_launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/var/mobile/wg_launchd.err</string>
</dict>
</plist>
